{
  "name": "notes-plus-plus",
  "version": "1.4.1",
  "description": "Notes++ — un cahier de cours moderne : dossiers, mise en forme riche, thème clair/sombre, export PDF.",
  "main": "app/main.js",
  "scripts": {
    "build": "node scripts/make-pictos.mjs && esbuild src/renderer/app.js --bundle --minify --format=iife --target=chrome130 --outfile=app/dist/renderer.js",
    "watch": "npm run build -- --watch --sourcemap",
    "start": "npm run build && electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "installer-art": "node scripts/make-installer-art.mjs",
    "update-feed": "node scripts/update-feed.mjs"
  },
  "author": "maxencepialleport",
  "license": "MIT",
  "devDependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@twemoji/svg": "^15.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "emojibase-data": "^17.0.0",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "node-llama-cpp@3.22.1": true
  },
  "productName": "Notes++",
  "build": {
    "appId": "com.notesplusplus.app",
    "productName": "Notes++",
    "copyright": "© 2026 Notes++",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json",
      "!node_modules/node-llama-cpp/bins/**/*",
      "node_modules/node-llama-cpp/bins/${os}-${arch}*/**/*",
      "!node_modules/node-llama-cpp/llama/localBuilds/**/*",
      "node_modules/node-llama-cpp/llama/localBuilds/${os}-${arch}*/**/*",
      "!node_modules/@node-llama-cpp/*/bins/**/*",
      "node_modules/@node-llama-cpp/${os}-${arch}*/bins/**/*",
      "!node_modules/@node-llama-cpp/*cuda*/**/*",
      "!node_modules/node-llama-cpp/llama/llama.cpp/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NotesPlusPlus-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes++",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "NotesPlusPlus-Setup.${ext}",
      "language": "1036",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/Maxence-P-dev/notes-plus-plus/main/update/"
      }
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins",
      "node_modules/node-llama-cpp/llama/localBuilds",
      "node_modules/@node-llama-cpp/*"
    ]
  },
  "dependencies": {
    "dictionary-fr": "^3.0.0",
    "electron-updater": "^6.8.9",
    "node-llama-cpp": "^3.22.1",
    "nspell": "^2.1.5"
  }
}
